+/// Browse both DNS-SD and AWDL peers: iPhones often do not send mDNS here.
+async fn browse_desktop(args: BrowseArgs) -> io::Result<ExitCode> {
+    let (iface, name) = args.on.resolve()?;
+    let _advert = advertise(args.no_ble).await;
+    let sender = Sender::new(sender::Config::new(name, random_service_id()?))?;
+    let lease = Lease::find(None, &iface.name).await.ok();
+    let limit = Duration::from_secs(args.seconds);
+    let mdns = browse_receivers(&iface, &sender, limit, |r| {
+        let _ = desktop_emit(serde_json::json!({"event":"peer","id":r.instance,"name":r.name}));
+        false
+    });
+    let peers = async {
+        let Some(lease) = lease else { return };
+        let deadline = tokio::time::Instant::now() + limit;
+        let mut seen = BTreeSet::new();
+        while tokio::time::Instant::now() < deadline {
+            for mac in lease.peers().await {
+                let id = mac.to_string();
+                if seen.contains(&id) { continue; }
+                let addr = SocketAddrV6::new(mac.link_local(), AIRDROP_PORT, 0, iface.index);
+                let wait = deadline.saturating_duration_since(tokio::time::Instant::now()).min(Duration::from_secs(2));
+                if let Ok(Ok(Some(r))) = tokio::time::timeout(wait, sender.discover(addr)).await {
+                    let _ = desktop_emit(serde_json::json!({"event":"peer","id":id,"name":r.computer_name}));
+                    seen.insert(id);
+                }
+            }
+            tokio::time::sleep(Duration::from_millis(500)).await;
+        }
+    };
+    let _ = tokio::join!(mdns, peers);
+    desktop_emit(serde_json::json!({"event":"discovery_done"}))?;
+    Ok(ExitCode::SUCCESS)
+}
