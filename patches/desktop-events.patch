+#[derive(serde::Deserialize)]
+#[serde(deny_unknown_fields)]
+struct DesktopAnswer {
+    id: u64,
+    accept: bool,
+}
+
+fn desktop_emit(value: serde_json::Value) -> io::Result<()> {
+    use std::io::Write;
+    let mut out = std::io::stdout().lock();
+    serde_json::to_writer(&mut out, &value)?;
+    out.write_all(b"\n")?;
+    out.flush()
+}
+
+async fn desktop_events(
+    mut events: tokio::sync::mpsc::Receiver<ReceiverEvent>,
+) -> io::Result<ExitCode> {
+    use serde_json::json;
+    let mut pending = std::collections::HashMap::new();
+    let mut stdin = tokio::io::BufReader::new(tokio::io::stdin()).lines();
+    desktop_emit(json!({"event":"ready"}))?;
+    loop {
+        tokio::select! {
+            _ = tokio::signal::ctrl_c() => return Ok(ExitCode::SUCCESS),
+            line = stdin.next_line() => {
+                let Some(line) = line? else { return Ok(ExitCode::SUCCESS) };
+                if line.len() > 1024 { continue; }
+                let Ok(answer) = serde_json::from_str::<DesktopAnswer>(&line) else { continue };
+                if let Some(request) = pending.remove(&answer.id) {
+                    let request: owly_airdrop::driver::receiver::Request = request;
+                    if answer.accept { request.accept(); } else { request.decline(); }
+                    desktop_emit(json!({"event":"answered","id":answer.id,"accepted":answer.accept}))?;
+                }
+            }
+            event = events.recv() => {
+                let Some(event) = event else { return Ok(ExitCode::SUCCESS) };
+                match event {
+                    ReceiverEvent::Discovered { .. } => {},
+                    ReceiverEvent::Request(request) => {
+                        let files = match &request.ask.offer {
+                            Offer::Files(files) => files.iter().map(|f| json!({"name":f.name,"size":f.size})).collect::<Vec<_>>(),
+                            Offer::Urls(_) => vec![],
+                        };
+                        let urls = match &request.ask.offer { Offer::Urls(urls) => urls.clone(), _ => vec![] };
+                        desktop_emit(json!({"event":"request","id":request.id,
+                            "sender":request.ask.sender_computer_name,"fingerprint":request.peer_fingerprint,"files":files,"urls":urls,"timeout":15}))?;
+                        pending.insert(request.id, request);
+                    },
+                    ReceiverEvent::Withdrawn { id } => {
+                        pending.remove(&id);
+                        desktop_emit(json!({"event":"withdrawn","id":id}))?;
+                    },
+                    ReceiverEvent::Received { id, paths } => {
+                        desktop_emit(json!({"event":"received","id":id,"paths":paths}))?;
+                    },
+                    ReceiverEvent::Urls { id, urls } => {
+                        desktop_emit(json!({"event":"urls","id":id,"urls":urls}))?;
+                    },
+                    ReceiverEvent::Failed { id, reason } => {
+                        pending.remove(&id);
+                        desktop_emit(json!({"event":"failed","id":id,"reason":reason}))?;
+                    },
+                }
+            }
+        }
+    }
+}
